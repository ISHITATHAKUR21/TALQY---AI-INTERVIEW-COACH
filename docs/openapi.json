  "components": {
    "schemas": {
      "Analyze": {
        "properties": {
          "resume": {
            "type": "string",
            "title": "Resume"
          },
          "jd": {
            "type": "string",
            "title": "Jd"
          },
          "role": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Role"
          },
          "experience": {
            "type": "string",
            "enum": [
              "Fresher",
              "Entry Level",
              "Intermediate",
              "Experienced"
            ],
            "title": "Experience"
          },
          "category": {
            "type": "string",
            "enum": [
              "HR",
              "Technical",
              "Behavioral",
              "Mixed"
            ],
            "title": "Category"
          },
          "company": {
            "type": "string",
            "maxLength": 120,
            "title": "Company",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "resume",
          "jd",
          "role",
          "experience",
          "category"
        ],
        "title": "Analyze"
      },
      "Answer": {
        "properties": {
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "recording_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recording Id"
          }
        },
        "type": "object",
        "required": [
          "turn_id",
          "text"
        ],
        "title": "Answer"
      },
      "Body_audio_api_audio_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "interview_id": {
            "type": "string",
            "title": "Interview Id"
          },
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "interview_id",
          "turn_id"
        ],
        "title": "Body_audio_api_audio_transcribe_post"
      },
      "Body_upload_api_documents_upload__kind__post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_documents_upload__kind__post"
      },
      "Change": {
        "properties": {
          "current": {
            "type": "string",
            "title": "Current"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "current",
          "password"
        ],
        "title": "Change"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "remember": {
            "type": "boolean",
            "title": "Remember",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Forgot": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "Forgot"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "maxLength": 120,
            "title": "Role",
            "default": ""
